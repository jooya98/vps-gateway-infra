[Unit]
Description=Private DNS and SNI steering gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=${SNIPROXY_BIN} --config ${SNIPROXY_CONFIG_PATH}
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sniproxy

[Install]
WantedBy=multi-user.target
