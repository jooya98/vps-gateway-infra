# Managed by vps-gateway-infra. Do not edit on the host.
# The bootstrap phase detects the effective SSH listener and supplies SSH_PORT.
# Keep the listener unchanged while tightening authentication to avoid lockout.
Port ${SSH_PORT}
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
PermitEmptyPasswords no
