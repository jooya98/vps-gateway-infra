# Explicit resilient profile. DNS steering owns 443, so VLESS moves to 8443.
# TLS transports require an operator-provided certificate/key pair.
PROFILE_NAME=gateway-resilient
ENABLE_VLESS=true
ENABLE_SHADOWSOCKS=true
ENABLE_VMESS=false
ENABLE_TROJAN=false
ENABLE_HYSTERIA2=false
ENABLE_TUIC=false
ENABLE_SOCKS=true
ENABLE_DNS_STEERING=true
ENABLE_CLOUDFLARED=false
VLESS_PORT=8443
SHADOWSOCKS_PORT=8444
VMESS_PORT=8445
TROJAN_PORT=8446
HYSTERIA2_PORT=8447
TUIC_PORT=8448
SOCKS_LISTEN_ADDRESS=127.0.0.1
SOCKS_LISTEN_PORT=1080
SING_BOX_LOG_LEVEL=info
