# Single comprehensive production profile for the VPS gateway.
# bootstrap.sh is the only public entrypoint; helper scripts consume this profile.
PROFILE_NAME=gateway

# Primary direct transports.
REALITY_LISTEN_ADDRESS=0.0.0.0
REALITY_PORT=8443
SHADOWSOCKS_LISTEN_ADDRESS=0.0.0.0
SHADOWSOCKS_PORT=8444
SHADOWSOCKS_2022_LISTEN_ADDRESS=0.0.0.0
SHADOWSOCKS_2022_PORT=8445

# Cloudflare Tunnel origins (loopback-only).
VLESS_WS_PORT=18080
VLESS_WS_PATH=/vless-ws
VLESS_HTTPUPGRADE_PORT=18082
VLESS_HTTPUPGRADE_PATH=/vless-hu
VMESS_WS_PORT=18081
VMESS_WS_PATH=/vmess-ws
PUBLIC_HOSTNAME=echo.engine.qzz.io
DIRECT_HOSTNAME=direct.echo.engine.qzz.io

# Direct authenticated proxy endpoints.
SOCKS_LISTEN_ADDRESS=0.0.0.0
SOCKS_LISTEN_PORT=1080
HTTP_LISTEN_ADDRESS=0.0.0.0
HTTP_PORT=8080

# Direct TLS / QUIC family.
ENABLE_DIRECT_TLS=1
HYSTERIA2_PORT=8446
TUIC_PORT=8447
TROJAN_PORT=8448
ANYTLS_PORT=8449
VLESS_GRPC_PORT=8450
TLS_SERVER_NAME=direct.echo.engine.qzz.io
TLS_CERT_PATH=/etc/sing-box/server.crt
TLS_KEY_PATH=/etc/sing-box/server.key
TLS_CERTBOT_NAME=echo-gateway

# Local-managed Cloudflare Tunnel.
CLOUDFLARED_CONFIG_PATH=/etc/cloudflared/echo-config.yml
CLOUDFLARED_CREDENTIALS_PATH=/etc/cloudflared/echo-tunnel.json
CLOUDFLARE_TUNNEL_NAME=echo-gateway
CLOUDFLARE_ZONE_NAME=engine.qzz.io

# Certificate automation.
CERTBOT_BIN=/usr/local/bin/certbot
CERTBOT_CREDENTIALS_PATH=/root/.secrets/certbot/cloudflare.ini
CERTBOT_EMAIL=

# Generated secrets are stored in the protected runtime file.
MULTI_SHADOWSOCKS_PASSWORD=
MULTI_SHADOWSOCKS_2022_PASSWORD=
MULTI_HYSTERIA2_PASSWORD=
MULTI_TUIC_UUID=
MULTI_TUIC_PASSWORD=
MULTI_TROJAN_PASSWORD=
MULTI_ANYTLS_PASSWORD=

SING_BOX_LOG_LEVEL=info
