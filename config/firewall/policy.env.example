# Public ingress policy. The firewall script also loads the selected profile and
# runtime env, then derives rules from enabled components.
SSH_PORT=22
VLESS_PORT=443
SHADOWSOCKS_PORT=8444
VMESS_PORT=8445
TROJAN_PORT=8446
HYSTERIA2_PORT=8447
TUIC_PORT=8448
DNS_PORT=53
SOCKS_PORT=1080
SSH_ALLOW_FROM=any
VLESS_ALLOW_FROM=any
SHADOWSOCKS_ALLOW_FROM=any
VMESS_ALLOW_FROM=any
TROJAN_ALLOW_FROM=any
HYSTERIA2_ALLOW_FROM=any
TUIC_ALLOW_FROM=any
DNS_ALLOW_FROM=127.0.0.1
SOCKS_ALLOW_FROM=127.0.0.1
ALLOW_PUBLIC_SOCKS=false
