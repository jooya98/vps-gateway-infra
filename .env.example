# Copy to an ignored runtime file; never commit the populated copy.
VLESS_UUID=
REALITY_PRIVATE_KEY=
REALITY_SHORT_ID=
SOCKS_USERNAME=llm
SOCKS_PASSWORD=
TRANSPORT_PASSWORD=
CLOUDFLARED_TUNNEL_TOKEN=

# Optional resilient DNS steering inputs
SNIPROXY_PUBLIC_IPV4=
SNIPROXY_PUBLIC_IPV6=
DNS_ALLOWED_CIDRS=127.0.0.1/32,allow

# Optional TLS transport inputs
TLS_SERVER_NAME=
TLS_CERT_PATH=/etc/sing-box/server.crt
TLS_KEY_PATH=/etc/sing-box/server.key

# Non-secret settings can be overridden here
SING_BOX_LOG_LEVEL=info
