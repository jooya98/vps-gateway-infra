# Declarative public ingress policy.
# SSH should be restricted to an administrative CIDR in a real deployment.
SSH_PORT=22
VLESS_PORT=443
# Disabled by default because the reference exposed SOCKS publicly.
ALLOW_PUBLIC_SOCKS=false
SOCKS_PORT=1080
SSH_ALLOW_FROM=any
VLESS_ALLOW_FROM=any
SOCKS_ALLOW_FROM=any
