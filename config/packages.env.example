# Minimal operator package profile for a clean Debian VPS.
# Copy this file to config/packages.env and adjust only with explicit review.
# The real config/packages.env is ignored by Git and must not contain secrets.

BASE_PACKAGES="
ca-certificates
curl
wget
git
sudo
nano
vim
tmux
jq
unzip
tar
gzip
rsync
"

SHELL_PACKAGES="
fish
bash-completion
"

SYSTEM_DEBUG_PACKAGES="
btop
htop
ncdu
tree
"

NETWORK_DEBUG_PACKAGES="
iproute2
net-tools
dnsutils
traceroute
mtr-tiny
tcpdump
nmap
netcat-openbsd
openssl
whois
"

CONTAINER_SUPPORT_PACKAGES="
gnupg
lsb-release
"
